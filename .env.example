# Pickwise local configuration. `make dev` copies this to .env and fills every
# empty secret below inside the tools container. Existing values are never
# overwritten. Never commit .env.

PICKWISE_ENV=development
LOG_LEVEL=INFO

# Virus scanner: `stub` (make dev, dev only) or `clamav` (make dev-full, CI, production).
SCANNER=stub

# --- Secrets (generated) ------------------------------------------------------
# Master key-encryption key (base64, 32 bytes). The only global crypto secret.
PICKWISE_KEK=
SESSION_SECRET=

# Development/test only: password for the demo tenants' logins (make seed-demo).
DEMO_PASSWORD=

# Postgres superuser (initdb only) and the login users from CLAUDE.md rule 4.
POSTGRES_PASSWORD=
PG_MIGRATOR_PASSWORD=
PG_API_PASSWORD=
PG_WORKER_PASSWORD=
PG_MAINT_PASSWORD=

# Object storage (SeaweedFS S3 gateway in dev).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Non-secret settings -------------------------------------------------------
S3_REGION=us-east-1
S3_BUCKET_FILES=pickwise-files
S3_BUCKET_QUARANTINE=pickwise-quarantine
# The browser-facing origin. The API is served under <PUBLIC_BASE_URL>/api.
PUBLIC_BASE_URL=http://localhost:3000
# Self-serve tenant signup (ADR 0007). Off by default.
SIGNUP_ENABLED=false

# Browser-facing S3 origin (presigned uploads) and web origin (bucket CORS).
S3_PUBLIC_URL=http://localhost:8333
WEB_ORIGIN=http://localhost:3000

# Jev (TypeSafe). Tests and CI never call the live API.
JEV_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
